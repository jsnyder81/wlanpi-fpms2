# Dockerfile for building wlanpi-fpms2 Debian package
# Usage: podman build --no-cache -f Dockerfile.build -t wlanpi-fpms2-builder .
#        podman run --rm -v $(pwd):/work -w /work wlanpi-fpms2-builder

FROM debian:bullseye

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    debhelper \
    dh-python \
    dh-virtualenv \
    python3 \
    python3-dev \
    python3-setuptools \
    python3-distutils \
    python3-venv \
    pkg-config \
    libjpeg-dev \
    libopenjp2-7-dev \
    zlib1g-dev \
    libfreetype6-dev \
    devscripts \
    equivs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

CMD ["dpkg-buildpackage", "-us", "-uc", "-b"]
